# Runtime
APP_ENV=development
WEB_ORIGIN=http://127.0.0.1:3000
API_ORIGIN=http://127.0.0.1:8010
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8010
LOG_LEVEL=INFO

# Database
POSTGRES_DB=healthpick
POSTGRES_USER=healthpick
POSTGRES_PASSWORD=replace-with-local-secret
POSTGRES_PORT=54329
DATABASE_URL=postgresql://healthpick:replace-with-local-secret@127.0.0.1:54329/healthpick
CONVERSATION_STORE_MODE=auto
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Public request boundaries
MAX_REQUEST_BODY_BYTES=32768

# LLM provider adapter
LLM_MODE=mock
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://example-llm-provider.invalid/v1
LLM_API_KEY=replace-with-local-secret
LLM_MODEL=replace-with-evaluated-model
LLM_TIMEOUT_SECONDS=30
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=openai_compatible
LLM_FALLBACK_BASE_URL=https://example-backup-llm-provider.invalid/v1
LLM_FALLBACK_API_KEY=replace-with-backup-secret
LLM_FALLBACK_MODEL=replace-with-evaluated-backup-model
LLM_FALLBACK_TIMEOUT_SECONDS=30

# Embedding provider adapter
EMBEDDING_MODE=disabled
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://example-embedding-provider.invalid/v1
EMBEDDING_API_KEY=replace-with-local-secret
EMBEDDING_MODEL=replace-with-evaluated-embedding-model
EMBEDDING_DIMENSIONS=replace-with-model-dimensions

# Retrieval: keyword until ACTION-03 confirms a real embedding manifest
RETRIEVAL_MODE=keyword

# Docker Compose application overrides (kept separate from direct API settings)
COMPOSE_APP_ENV=development
COMPOSE_WEB_ORIGIN=http://127.0.0.1:3000
COMPOSE_API_ORIGIN=http://127.0.0.1:8010
COMPOSE_PUBLIC_API_ORIGIN=http://127.0.0.1:8010
COMPOSE_LLM_MODE=real
COMPOSE_LLM_BASE_URL=http://host.docker.internal:11434/v1
COMPOSE_LLM_API_KEY=ollama-local
COMPOSE_LLM_MODEL=qwen2.5:3b-instruct
COMPOSE_EMBEDDING_MODE=disabled
COMPOSE_RETRIEVAL_MODE=keyword

# Optional observability
SENTRY_DSN=
