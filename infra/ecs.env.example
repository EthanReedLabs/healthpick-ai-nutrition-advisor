# Public endpoint. The China mainland ECS uses a public IP certificate because
# an unfiled sslip.io hostname is blocked by Alibaba Cloud ICP enforcement.
PUBLIC_HOST=106.14.13.139

# Release identity
IMAGE_TAG=v0.1.0-rc5

# Bind application services to loopback; only Caddy exposes public ports.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=54329
API_BIND_ADDRESS=127.0.0.1
API_PORT=8010
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# Database secret: replace on the server and keep the file mode at 0600.
POSTGRES_DB=healthpick
POSTGRES_USER=healthpick
POSTGRES_PASSWORD=replace-with-random-production-secret

# Public same-origin application contract
COMPOSE_APP_ENV=production
COMPOSE_WEB_ORIGIN=https://106.14.13.139
COMPOSE_API_ORIGIN=https://106.14.13.139
COMPOSE_PUBLIC_API_ORIGIN=https://106.14.13.139
COMPOSE_DATABASE_CONNECT_TIMEOUT_SECONDS=5
COMPOSE_DATABASE_STATEMENT_TIMEOUT_MS=5000
COMPOSE_MAX_REQUEST_BODY_BYTES=32768

# Alibaba Cloud Model Studio (Bailian) Token Plan, Beijing region.
# sk-sp- keys must use the Token Plan endpoint and cannot use the generic
# dashscope.aliyuncs.com endpoint.
COMPOSE_LLM_MODE=real
COMPOSE_LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
COMPOSE_LLM_API_KEY=replace-with-token-plan-bailian-secret
COMPOSE_LLM_MODEL=qwen3.7-plus
COMPOSE_LLM_TIMEOUT_SECONDS=45
COMPOSE_EMBEDDING_MODE=disabled
COMPOSE_RETRIEVAL_MODE=keyword
