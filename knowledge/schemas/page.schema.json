{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthpick.local/schemas/page.schema.json",
  "title": "KnowledgePage",
  "type": "object",
  "required": ["schema_version", "page_id", "source_code", "source_role", "source_sha256", "page", "page_count", "raw_text", "normalized_text", "blocks", "quality", "review_status"],
  "properties": {
    "schema_version": {"const": 1},
    "page_id": {"type": "string", "pattern": "^[ABC]-p[0-9]{2}$"},
    "source_code": {"enum": ["A", "B", "C"]},
    "source_role": {"enum": ["core_nutrition", "auxiliary_platform"]},
    "source_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "page": {"type": "integer", "minimum": 1},
    "page_count": {"type": "integer", "minimum": 1},
    "raw_text": {"type": "string"},
    "normalized_text": {"type": "string", "minLength": 1},
    "blocks": {"type": "array", "minItems": 1},
    "quality": {"type": "object"},
    "review_status": {"enum": ["verified", "review_required", "rejected"]}
  },
  "additionalProperties": true
}

