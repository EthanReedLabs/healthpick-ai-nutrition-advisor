{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthpick.local/schemas/platform-fact.schema.json",
  "title": "PlatformFact",
  "type": "object",
  "required": ["schema_version", "fact_id", "fact_type", "title", "value", "source_code", "source_role", "source_sha256", "pages", "section", "allowed_routes", "forbidden_routes", "claim_scope", "review_status"],
  "properties": {
    "schema_version": {"const": 1},
    "fact_id": {"type": "string", "pattern": "^platform-C-[a-z0-9_]+$"},
    "fact_type": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "value": {"type": "object", "minProperties": 1},
    "source_code": {"const": "C"},
    "source_role": {"const": "auxiliary_platform"},
    "source_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "pages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 5}},
    "section": {"type": "string", "minLength": 1},
    "allowed_routes": {"const": ["platform"]},
    "forbidden_routes": {"type": "array", "allOf": [{"contains": {"const": "nutrition"}}, {"contains": {"const": "recommendation"}}, {"contains": {"const": "contraindication"}}]},
    "claim_scope": {"const": "provided_whitepaper_only"},
    "review_status": {"enum": ["verified", "review_required", "rejected"]},
    "first_pass_review": {"type": "object"},
    "second_person_review": {
      "type": "object",
      "required": ["reviewer", "date", "notes"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  },
  "additionalProperties": true
}
